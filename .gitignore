# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*
offline_maps/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# unwanted textures
Content/YI_TankCollection/Textures/Ignore/
*.sqlite
*.json
/Plugins/Monolith
*.pyc
*.py
/Content/YI_TankCollection/Textures
/Content/YI_TankCollection/Maps
# Maps are NO LONGER ignored - they are tracked through Git LFS instead. See .gitattributes:
#   *.umap filter=lfs diff=lfs merge=lfs -text
# WarZone.umap is 167MB, over GitHub's hard 100MB per-file limit, so it can only reach the
# remote as an LFS object. Anyone cloning needs git-lfs installed, or the .umap files arrive
# as small pointer stubs and the editor will fail to open them.
# Quota note: GitHub's free LFS tier is 1GB storage and 1GB/month bandwidth, so roughly six
# fetches of WarZone.umap per month before a paid data pack is needed.
