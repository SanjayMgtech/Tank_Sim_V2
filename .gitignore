# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*
offline_maps/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# unwanted textures
Content/YI_TankCollection/Textures/Ignore/
*.sqlite
*.json
/Plugins/Monolith
*.pyc
*.py
/Content/YI_TankCollection/Textures
/Content/YI_TankCollection/Maps
# WarZone.umap is 167MB - over GitHub's hard 100MB per-file limit - so this folder stays
# ignored. Consequence: spawn points placed as ACTORS in WarZone do not reach a fresh clone.
# ATSGameMode::FallbackTeamSpawnTransforms carries them as GameMode data instead, which IS
# committed. Un-ignore this folder only behind Git LFS.
# Note the trailing /* : git cannot re-include a file whose parent DIRECTORY is excluded, so
# excluding the contents rather than the folder is what makes the MainMenu exception below work.
/Content/TankSimulation/Maps/*
# MainMenu is 9KB and is the game's startup map - without it a clone cannot launch at all.
!/Content/TankSimulation/Maps/MainMenu.umap
